# Скопируйте этот файл в .env и заполните своими значениями:
#   cp .env.example .env        (Linux/macOS)
#   Copy-Item .env.example .env (PowerShell)

# Ключ доступа к LLM (обязательно)
LLM_API_KEY=your_api_key_here

# Имя модели, например: qwen2.5-coder-32b-instruct, gpt-4o-mini, deepseek-chat (обязательно)
LLM_MODEL=your_model_name

# Базовый URL OpenAI-совместимого эндпоинта (опционально).
# Для официального OpenAI можно не указывать.
LLM_BASE_URL=https://api.your-provider.com/v1
